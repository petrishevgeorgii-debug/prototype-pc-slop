<?xml version="1.0" encoding="utf-8"?>
<!-- PROTOTYPE 2 (PROTOTYPE BIOHAZARD BUNDLE, prototype2_ps4f.elf). Addresses are the executable's
     virtual addresses; each line also carries the original bytes as its Pattern, so a site is
     only written where the code is exactly the one these patches were made for. -->
<Patch>
    <TitleID>
        <ID>CUSA06545</ID>
    </TitleID>
    <Metadata Title="Prototype 2"
              Name="Prototype 2 60 FPS"
              Note="Experimental: the game presents every vblank (flip rate 60 Hz instead of 30 Hz). The game steps by measured time; videos and menus may need checking."
              Author="prototype-port"
              PatchVer="1.0"
              AppVer="01.00"
              AppElf="prototype2_ps4f.elf"
              isEnabled="false">
        <PatchList>
            <!-- sceVideoOutSetFlipRate(handle, 1) at start: rate 0. -->
            <Line Type="bytes" Address="0x0027bf05" Value="be00000000" Pattern="41 c7 87 7c 01 00 00 99 99 01 3f 41 8b 3e be 01 00 00 00" At="14"/>
        </PatchList>
    </Metadata>
    <Metadata Title="Prototype 2"
              Name="Render Resolution - 1280x720"
              Note="Experimental: the game renders at 1280x720 instead of 1920x1080 (display device, back buffers and the renderer's target size). The window shows the image scaled to its own size."
              Author="prototype-port"
              PatchVer="1.0"
              AppVer="01.00"
              AppElf="prototype2_ps4f.elf"
              isEnabled="false">
        <PatchList>
