            <Line Type="bytes" Address="0x0027be83" Value="48b800050000d0020000498907" Pattern="48 b8 80 07 00 00 38 04 00 00 49 89 07" At="0"/>
            <!-- Pure3D display init parameters -->
            <Line Type="bytes" Address="0x00112f32" Value="c78554feffff0005000048b8d002000020000000" Pattern="c7 85 54 fe ff ff 80 07 00 00 48 b8 38 04 00 00 20 00 00 00" At="0"/>
            <!-- the display's render size (virtual getters returning 1920 / 1080) -->
            <Line Type="bytes" Address="0x00d4e6b0" Value="b800050000c3" Pattern="b8 80 07 00 00 c3 90 90" At="0"/>
            <Line Type="bytes" Address="0x00d4e6c0" Value="b8d0020000c3" Pattern="b8 38 04 00 00 c3 90 90" At="0"/>
