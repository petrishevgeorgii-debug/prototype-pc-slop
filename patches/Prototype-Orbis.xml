    <Metadata Title="Prototype"
              Name="Fix White Consume Tendrils"
              Note="The dummy vertex stream is filled with zeros instead of 0xDEADBEEF (the GPU layer reads past it; on the PS4 those reads return zero). Fixes white veins when Mercer consumes someone."
              Author="prototype-port"
              PatchVer="1.0"
              AppVer="01.00"
              AppElf="eboot.bin"
              isEnabled="true">
        <PatchList>
            <Line Type="bytes" Address="0x00c9b550" Value="00000000000000000000000000000000" Pattern="ef be ad de ef be ad de ef be ad de ef be ad de" At="0"/>
        </PatchList>
    </Metadata>
