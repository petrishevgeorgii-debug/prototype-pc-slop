// port: PROTOTYPE screen-space reflections, step 2 (vk_screen_reflections.cpp). For each water
// pixel (mask), a ray is reflected about the water plane (world up, in view space) and marched
// through the scene depth; the colour it hits is blended over the game's own (sky cube map)
// reflection by a Fresnel term. Rays that reach nothing take what lies far away in their
// direction on the screen (skyline, clouds); off screen they keep the game's reflection.
// View space as in camera_motion.comp: depth = proj.z + proj.w / z (D3D, z = view distance),
// ndc y up, uv y down.
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba8) uniform readonly image2D source_img; // scene colour before this pass
layout(binding = 1) uniform texture2D depth_tex;                 // scene depth (depth aspect)
layout(binding = 2, r8) uniform readonly image2D mask_img;       // 1 = water
layout(binding = 3, rgba8) uniform image2D color_img;            // scene colour, written

layout(push_constant) uniform Constants {
    vec4 proj;     // x scale, y scale, z scale, z offset
    vec4 up;       // xyz: world up in view space; w: strength
    vec2 size;     // pixels
    float max_distance;
    uint mode;     // 0 reflections, 1 show the water mask, 2 show the hits
};

const int STEPS = 48;
const int REFINE = 6;

float ViewZ(float depth) {
    return depth >= 1.0 ? 1e9 : proj.w / min(depth - proj.z, -1e-8);
}

vec3 ViewPos(vec2 uv, float depth) {
    const float z = ViewZ(depth);
    const vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    return vec3(ndc.x * z / proj.x, ndc.y * z / proj.y, z);
}

vec2 Project(vec3 v) {
    const vec2 ndc = v.xy * proj.xy / v.z;
    return vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
}

float SceneZ(vec2 uv) {
    const ivec2 p = clamp(ivec2(uv * size), ivec2(0), ivec2(size) - 1);
    return ViewZ(texelFetch(depth_tex, p, 0).r);
}

float Luma(ivec2 p) {
    p = clamp(p, ivec2(0), ivec2(size) - 1);
    return dot(imageLoad(source_img, p).rgb, vec3(0.299, 0.587, 0.114));
}

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(size.x) || pixel.y >= int(size.y)) {
        return;
    }
    if (imageLoad(mask_img, pixel).r < 0.5) {
        return;
    }
    const vec4 current = imageLoad(color_img, pixel);
    if (mode == 1u) {
        imageStore(color_img, pixel, vec4(mix(current.rgb, vec3(1.0, 0.0, 0.0), 0.5), current.a));
        return;
    }
    const float depth = texelFetch(depth_tex, pixel, 0).r;
    if (depth >= 1.0) {
        return;
    }
    const vec2 uv = (vec2(pixel) + 0.5) / size;
    const vec3 position = ViewPos(uv, depth);
    const vec3 view_dir = normalize(position);
    const vec3 normal = normalize(up.xyz);

    // The ray leaves the flat water plane: every pixel of a stretch of water reflects the same
    // picture (tilting each ray by the waves scattered the hits into noise). The waves move
    // the picture instead, below.
    const vec3 ray = reflect(view_dir, normal);
    if (dot(ray, normal) <= 0.0) {
        return;
    }

    // Steps grow geometrically from 0.25 units to max_distance.
    const float growth = pow(max_distance / 0.25, 1.0 / float(STEPS - 1));
    float previous_t = 0.0;
    float t = 0.25;
    bool hit = false;
    vec2 hit_uv = vec2(0.0);
    for (int i = 0; i < STEPS; ++i) {
        const vec3 q = position + ray * t;
        if (q.z < 0.1) {
            break;
        }
        const vec2 q_uv = Project(q);
        if (any(lessThan(q_uv, vec2(0.0))) || any(greaterThan(q_uv, vec2(1.0)))) {
            break;
        }
        const float scene_z = SceneZ(q_uv);
        const float behind = q.z - scene_z;
        // Behind the surface by no more than the step just taken: the ray crossed it.
        if (behind > 0.0 && behind < (t - previous_t) * 1.5 + q.z * 0.01 + 0.2) {
            float lo = previous_t, hi = t;
            for (int k = 0; k < REFINE; ++k) {
                const float mid = 0.5 * (lo + hi);
                const vec3 m = position + ray * mid;
                if (m.z - SceneZ(Project(m)) > 0.0) {
                    hi = mid;
                } else {
                    lo = mid;
                }
            }
            hit_uv = Project(position + ray * hi);
            t = hi;
            hit = imageLoad(mask_img, clamp(ivec2(hit_uv * size), ivec2(0), ivec2(size) - 1)).r < 0.5;
            break;
        }
        previous_t = t;
        t *= growth;
        if (t > max_distance) {
            break;
        }
    }
    // No surface within reach: what lies far away in the ray's direction (the skyline, the
    // clouds, distant bridges) is where the direction itself projects on the screen, if that
    // pixel shows something far away (a quarter of the rays' reach or more: little parallax),
    // not a nearer object and not water.
    bool far_hit = false;
    if (!hit && ray.z > 0.01) {
        const vec2 far_uv = Project(ray);
        if (all(greaterThanEqual(far_uv, vec2(0.0))) && all(lessThanEqual(far_uv, vec2(1.0)))) {
            const ivec2 far_pixel = clamp(ivec2(far_uv * size), ivec2(0), ivec2(size) - 1);
            const float far_z = SceneZ(far_uv);
            // Not the sky itself: the game's own reflection already shows it, in its colours.
            if (far_z > 0.25 * max_distance && far_z < 1e8 &&
                imageLoad(mask_img, far_pixel).r < 0.5) {
                hit_uv = far_uv;
                hit = true;
                far_hit = true;
            }
        }
    }
    if (mode == 2u) {
        const vec3 debug = far_hit ? vec3(1.0, 1.0, 0.0) : hit ? vec3(0.0, 1.0, 0.0) : vec3(0.0, 0.0, 1.0);
        imageStore(color_img, pixel, vec4(debug, current.a));
        return;
    }
    if (!hit) {
        return;
    }
    const float cosine = clamp(dot(-view_dir, normal), 0.0, 1.0);
    const float fresnel = 0.02 + 0.98 * pow(1.0 - cosine, 5.0);
    const vec2 edge2 = min(hit_uv, vec2(1.0) - hit_uv);
    const float edge = smoothstep(0.0, 0.06, min(edge2.x, edge2.y));
    const float distance_fade = far_hit ? 1.0 : 1.0 - smoothstep(0.6 * max_distance, max_distance, t);
    // At most 60%: the game's water keeps its own sheen and colour under the reflection.
    const float weight = clamp(fresnel * up.w, 0.0, 0.6) * edge * distance_fade;
    // Rippled water breaks a reflection up: the game's waves (the brightness gradient of its
    // water colour over a few pixels) shift the reflected picture, more for distant water
    // (smaller waves on screen, but more of them per pixel), and the picture is smeared,
    // mostly vertically (3 x 7 taps).
    const vec2 slope = vec2(Luma(pixel + ivec2(2, 0)) - Luma(pixel - ivec2(2, 0)),
                            Luma(pixel + ivec2(0, 2)) - Luma(pixel - ivec2(0, 2)));
    const float far_scale = 1.0 + clamp(position.z / 150.0, 0.0, 2.0);
    const vec2 ripple = clamp(slope, vec2(-0.25), vec2(0.25)) * vec2(0.012, 0.03) * far_scale;
    const ivec2 hit_pixel = ivec2((hit_uv + ripple) * size);
    const float unit = size.y / 1080.0;
    const int spread_y = max(1, int(unit * 2.0 * far_scale));
    const int spread_x = max(1, int(unit));
    vec3 reflected = vec3(0.0);
    for (int ky = -3; ky <= 3; ++ky) {
        for (int kx = -1; kx <= 1; ++kx) {
            const ivec2 tap = clamp(hit_pixel + ivec2(kx * spread_x, ky * spread_y), ivec2(0),
                                    ivec2(size) - 1);
            reflected += imageLoad(source_img, tap).rgb;
        }
    }
    reflected /= 21.0;
    // Water tints what it reflects: half of the reflection takes the hue of the game's water
    // colour at this pixel (the sunset gold), keeping the reflection's brightness.
    const vec3 weights = vec3(0.299, 0.587, 0.114);
    const float water_luma = max(dot(current.rgb, weights), 1e-3);
    const vec3 water_hue = clamp(current.rgb / water_luma, vec3(0.0), vec3(2.0));
    reflected = mix(reflected, dot(reflected, weights) * water_hue, 0.5) * 0.85;
    imageStore(color_img, pixel, vec4(mix(current.rgb, reflected, weight), current.a));
}
